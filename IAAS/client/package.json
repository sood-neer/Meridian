{
  "name": "meridian",
  "version": "1.0.0",
  "author": "Neerad Sood",
  "main": "src/index.js",
  "_comments": {
    "start": "The start script runs the React frontend, Node.js backend, and Flask LLM server concurrently."
  },
  "scripts": {
    "start": "concurrently --names \"FRONTEND,BACKEND,LLM\" --prefix-colors \"cyan,green,magenta\" \"npm run start:frontend\" \"npm run start:backend\" \"npm run start:llm\"",
    "start:frontend": "react-scripts start",
    "start:backend": "node server/server.js",
    "start:llm": "cd ../LLMAcadamic-Advisor && python3 start_flask.py || (echo '❌ Failed to start Flask server. Make sure Python3 is installed and dependencies are installed.' && exit 1)",
    "kill:servers": "pkill -f 'python.*start_flask' 2>/dev/null || true; pkill -f 'node.*server.js' 2>/dev/null || true",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "^5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3"
  }
}
