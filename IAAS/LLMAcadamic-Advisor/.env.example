# AI Academic Advisor - API Keys
# Copy to .env on your machine or EC2. Never commit .env to git.

# Required
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangSmith / LangChain tracing (optional but recommended on EC2)
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
# Project name in LangSmith (must match or create a project there)
LANGCHAIN_PROJECT=your-langsmith-project-name

# Optional: Web search (Tavily)
# TAVILY_API_KEY=tvly-your-tavily-key-here

# Optional: Model overrides
# ADVISOR_MODEL_NAME=gpt-4o-mini
# ADVISOR_CLASSIFIER_MODEL_NAME=gpt-4o-mini
